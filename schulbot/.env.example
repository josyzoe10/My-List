# Geheimnisse deines Bots.
# Am einfachsten füllst du sie mit "python einrichten.py" aus. Das Programm
# legt daraus die Datei ".env" an. Die Datei .env bleibt nur auf deinem Gerät
# und wird nie zu GitHub hochgeladen.

# Den Token bekommst du in Telegram von @BotFather (Befehl /newbot).
TELEGRAM_BOT_TOKEN=

# Deine eigene Telegram-ID (eine Zahl). Nur diese Person darf den Bot benutzen.
# Lass das Feld beim ersten Start leer: Der Bot nennt dir dann deine ID.
TELEGRAM_USER_ID=
